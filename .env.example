# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# GitHub Storage Configuration
# Tạo Personal Access Token tại: https://github.com/settings/tokens (cần quyền repo hoặc contents:write)
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=music-storage-repo
GITHUB_BRANCH=main

# SQLite Local Database (dùng trong backend)
DATABASE_PATH=./data/music.db

# FFmpeg binary path (nếu không nằm trong PATH hệ thống)
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
FFMPEG_PATH=

